COROS_EMAIL=tu-correo@example.com
COROS_PASSWORD=cambia-este-valor
COROS_REGION=eu
# Keep false (or omit it) so COROS Workout never opens a second mobile-app
# session. Sleep should be read through the official COROS MCP OAuth connector.
COROS_ALLOW_UNOFFICIAL_MOBILE_LOGIN=false

# Optional private athlete profile. Public/self-hosted copies ship with a generic
# template only. Keep personal constraints, goals and preferences outside Git.
# Prefer ATHLETE_PROFILE_PATH when mounting a private JSON file, or use
# ATHLETE_PROFILE_JSON when your host manages encrypted environment variables.
ATHLETE_PROFILE_PATH=
ATHLETE_PROFILE_JSON=

# Optional Strava provider. Register your own Strava application and complete
# OAuth with activity:read (or activity:read_all if private activities are needed).
# The provider persists rotated refresh/access tokens in a local 0600 file.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
# Optional bootstrap values; normally leave empty after the first setup.
STRAVA_ACCESS_TOKEN=
STRAVA_EXPIRES_AT=
# Optional custom location. Default: ~/.config/coros-workout-mcp/strava-auth.json
STRAVA_TOKEN_FILE=

# Optional Garmin Connect Developer Program provider.
# Garmin grants the Activity API configuration after project approval. Do not
# point these variables at undocumented/private Garmin Connect endpoints.
GARMIN_ACCESS_TOKEN=
# Templates may use {startDate}, {endDate}, {page}, {size}, {activityId}, {sportType}.
GARMIN_ACTIVITY_SUMMARIES_URL_TEMPLATE=
GARMIN_ACTIVITY_DETAIL_URL_TEMPLATE=

PORT=8787
